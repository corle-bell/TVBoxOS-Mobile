<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/common_corners" />
            <solid android:color="@color/colorPrimary" />
            <stroke android:width="2dp" android:color="@color/colorAccent" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="@dimen/common_corners" />
            <solid android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/common_corners" />
            <solid android:color="@color/gray_darker_press_alpha" />
            <stroke android:width="2dp" android:color="@color/colorPrimary" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/common_corners" />
            <stroke android:width="0.6dp" android:color="@color/colorPrimary" />
        </shape>
    </item>
</selector>
